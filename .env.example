# Copy to .env and fill in. Use with: uv run --env-file .env <command>
ANTHROPIC_API_KEY=

# Web app only.
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Encrypts stored Google tokens; losing it means everyone reconnects Google.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_KEY=
# From a "Web application" OAuth client in Google Cloud Console, with redirect URI
# http://localhost:8000/google/callback/ (and the same with 127.0.0.1).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
